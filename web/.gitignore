# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# /out is COMMITTED -- the engine serves it from the same origin and the
# deployed host has no Node toolchain to build it. This file is scaffolded
# by Next.js and is the SECOND gitignore in this repo; editing only the
# root one left this rule in force, so `git add -A` silently skipped new
# build chunks and the deployed site 404'd on a lazily-loaded chunk with
# ChunkLoadError. Nothing in index.html referenced it, so asset checks
# against the HTML did not catch it either.
# /out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
